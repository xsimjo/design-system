{
	"name": "@xsimjo/design-system",
	"version": "0.0.25",
	"publishConfig": {
		"registry": "https://npm.pkg.github.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/xsimjo/design-system.git"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run prepack",
		"generate:tokens": "node scripts/generate-tokens.js && npm run format",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"changeset": "changeset",
		"version-packages": "changeset version && npm install --package-lock-only --ignore-scripts",
		"release": "changeset publish"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./styles": "./dist/styles/global.css",
		"./styles/primitives": "./dist/styles/primitives.css",
		"./styles/themes/light": "./dist/styles/themes/light.css",
		"./styles/themes/dark": "./dist/styles/themes/dark.css",
		"./styles/themes/dev": "./dist/styles/themes/dev.css",
		"./styles/themes/qr": "./dist/styles/themes/qr.css"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@changesets/changelog-github": "^1.0.1",
		"@changesets/cli": "^3.0.3",
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.49.1",
		"@sveltejs/package": "^2.5.7",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@types/node": "^26.6.3",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.13.1",
		"globals": "^17.12.0",
		"prettier": "^3.7.4",
		"prettier-plugin-svelte": "^4.1.1",
		"publint": "^0.3.15",
		"shiki": "^4.4.3",
		"svelte": "^5.45.6",
		"svelte-check": "^4.3.4",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.48.1",
		"vite": "^8.0.0"
	},
	"keywords": [
		"svelte"
	],
	"dependencies": {
		"@floating-ui/dom": "^1.7.4"
	}
}
