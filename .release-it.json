{
	"hooks": {
		"before:init": ["npm run lint", "npm run build", "npm run generate:tokens"],
		"after:release": ["npm run format"]
	},
	"git": {
		"commitMessage": "chore: release v${version}"
	},
	"github": {
		"release": true
	},
	"npm": {
		"publish": true,
		"registry": "https://npm.pkg.github.com"
	}
}
